{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-setup.sh\"",
            "timeout": 180,
            "type": "command"
          }
        ],
        "matcher": "startup|resume"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(just)",
      "Bash(just bootstrap)",
      "Bash(just check)",
      "Bash(just check all)",
      "Bash(just test)",
      "Bash(just test-e2e)",
      "Bash(just coverage)",
      "Bash(just lint)",
      "Bash(just format)",
      "Bash(just format-check)",
      "Bash(just deny)",
      "Bash(just msrv)",
      "Bash(just budgets)",
      "Bash(just upgrade)",
      "Bash(just setup-llmlint)",
      "Bash(just session-setup)",
      "Bash(just lint-llm)",
      "Bash(just lint-llm-diff)",
      "Bash(just lint-llm-validate)",
      "Bash(llmlint doctor)",
      "Bash(cargo update --dry-run)",
      "Bash(bun outdated)",
      "Bash(./scripts/setup-llmlint.sh)",
      "Bash(./scripts/session-setup.sh)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log --oneline)",
      "Bash(just workload)",
      "Bash(just test-windows)"
    ],
    "deny": []
  }
}
