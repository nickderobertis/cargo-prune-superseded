{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "origin/main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "rust"
    ],
    "production": [
      "default",
      "!{projectRoot}/tests/**/*"
    ],
    "rust": [
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/rust-toolchain.toml",
      "{workspaceRoot}/.cargo/config.toml",
      "{workspaceRoot}/deny.toml"
    ]
  },
  "targetDefaults": {
    "format-check": {
      "inputs": [
        "default"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    },
    "build": {
      "inputs": [
        "production",
        "^production"
      ],
      "cache": false
    },
    "test": {
      "cache": false
    },
    "coverage": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "budgets": {
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "^production",
        {
          "dependentTasksOutputFiles": "**/telemetry/*.json"
        },
        {
          "externalDependencies": [
            "@onebudgetspec/cli"
          ]
        }
      ]
    },
    "budgets-host": {
      "cache": false
    },
    "typecheck": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    }
  }
}
