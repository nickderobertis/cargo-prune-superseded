{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "cargo-prune-superseded-workload",
  "projectType": "library",
  "tags": [
    "lang:rust",
    "type:e2e"
  ],
  "implicitDependencies": [
    "cargo-prune-superseded",
    "prune-fixtures"
  ],
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p cargo-prune-superseded-workload"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p cargo-prune-superseded-workload -- --check"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p cargo-prune-superseded-workload --all-targets --locked -- -D warnings"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check -p cargo-prune-superseded-workload --all-targets --locked"
      }
    },
    "workload": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{workspaceRoot}/dist/prune-workload"
      ],
      "options": {
        "commands": [
          "cargo test --locked -p cargo-prune-superseded-workload --test journeys",
          "bunx onebudgetspec check crates/cargo-prune-superseded/tests/workload/budgets.yaml"
        ],
        "parallel": false
      }
    }
  }
}
